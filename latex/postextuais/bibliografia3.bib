@INPROCEEDINGS{Ramakanth2013, 
author={S. A. Ramakanth and R. V. Babu}, 
booktitle={Computer Vision, Pattern Recognition, Image Processing and Graphics (NCVPRIPG), 2013 Fourth National Conference on}, 
title={OD-Match: PatchMatch based Optic Disk detection}, 
year={2013}, 
pages={1-4}, 
abstract={Approximate Nearest-Neighbour Field has been an area of interest in recent research for a wide variety of topics in graphics and multimedia community. Medical image processing is a relatively unaffected field by these developments in ANNF computations, brought about by various extremely efficient algorithms like PatchMatch. In this paper, we use Generalized PatchMatch for Optic Disk detection, in retinal images, and show that by making use of efficient ANNF computations we are able to generate results with 98% accuracy with an average time of 0.5 sec. This is significantly faster than conventional Optic Disk detection methods, which average at 95-97% accuracy with 3-5 sec average computation time.}, 
keywords={approximation theory;image matching;ANNF computations;OD-Match;approximate nearest-neighbour field;generalized PatchMatch;medical image processing;optic disk detection;retinal image;Accuracy;Adaptive optics;Biomedical optical imaging;Databases;Integrated optics;Optical imaging;Retina;Approximate Nearest Neighbour Field;Fundal Image processing;Generalized PatchMatch;Optic Disk detection}, 
note={{d}oi:\url{http://dx.doi.org/{10.1109/NCVPRIPG.2013.6776206}}}, 
month={Dec},}

@article{Ramakanth2014,
abstract = {Abstract Approximate Nearest Neighbour Field maps are commonly used by computer vision and graphics community to deal with problems like image completion, retargetting, denoising, etc. In this paper, we extend the scope of usage of {\{}ANNF{\}} maps to medical image analysis, more specifically to optic disk detection in retinal images. In the analysis of retinal images, optic disk detection plays an important role since it simplifies the segmentation of optic disk and other retinal structures. The proposed approach uses FeatureMatch, an {\{}ANNF{\}} algorithm, to find the correspondence between a chosen optic disk reference image and any given query image. This correspondence provides a distribution of patches in the query image that are closest to patches in the reference image. The likelihood map obtained from the distribution of patches in query image is used for optic disk detection. The proposed approach is evaluated on five publicly available DIARETDB0, DIARETDB1, DRIVE, {\{}STARE{\}} and {\{}MESSIDOR{\}} databases, with total of 1540 images. We show, experimentally, that our proposed approach achieves an average detection accuracy of 99{\%} and an average computation time of 0.2 s per image. },
author = {Ramakanth, S Avinash and Babu, R Venkatesh},
note={{d}oi:\url{http://dx.doi.org/10.1016/j.compmedimag.2013.10.007}},
issn = {0895-6111},
journal = {Computerized Medical Imaging and Graphics},
keywords = {Approximate Nearest Neighbour Field,FeatureMatch,Fundus or retinal image processing,Optic disk detection},
number = {1},
pages = {49--56},
title = {{Approximate Nearest Neighbour Field based Optic Disk Detection}},
volume = {38},
year = {2014}
}

