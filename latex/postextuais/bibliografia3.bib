@article{Rabbani2015,
abstract = {PURPOSE: To create and validate software to automatically segment leakage area in real-world clinical fluorescein angiography (FA) images of subjects with diabetic macular edema (DME).$\backslash$n$\backslash$nMETHODS: Fluorescein angiography images obtained from 24 eyes of 24 subjects with DME were retrospectively analyzed. Both video and still-frame images were obtained using a Heidelberg Spectralis 6-mode HRA/OCT unit. We aligned early and late FA frames in the video by a two-step nonrigid registration method. To remove background artifacts, we subtracted early and late FA frames. Finally, after postprocessing steps, including detection and inpainting of the vessels, a robust active contour method was utilized to obtain leakage area in a 1500-$\mu$m-radius circular region centered at the fovea. Images were captured at different fields of view (FOVs) and were often contaminated with outliers, as is the case in real-world clinical imaging. Our algorithm was applied to these images with no manual input. Separately, all images were manually segmented by two retina specialists. The sensitivity, specificity, and accuracy of manual interobserver, manual intraobserver, and automatic methods were calculated.$\backslash$n$\backslash$nRESULTS: The mean accuracy was 0.86 ± 0.08 for automatic versus manual, 0.83 ± 0.16 for manual interobserver, and 0.90 ± 0.08 for manual intraobserver segmentation methods.$\backslash$n$\backslash$nCONCLUSIONS: Our fully automated algorithm can reproducibly and accurately quantify the area of leakage of clinical-grade FA video and is congruent with expert manual segmentation. The performance was reliable for different DME subtypes. This approach has the potential to reduce time and labor costs and may yield objective and reproducible quantitative measurements of DME imaging biomarkers.},
author = {Rabbani, Hossein and Allingham, Michael J. and Mettu, Priyatham S. and Cousins, Scott W. and Farsiu, Sina},
note={{d}oi:\url{http://dx.doi.org/10.1167/iovs.14-15457}},
file = {:C$\backslash$:/Users/Cristiane/Dropbox/DoutoradoCristiane/PROJETO3/bibliografia/artigos{\_}9/i1552-5783-56-3-1482.pdf:pdf},
isbn = {0146-0404},
issn = {15525783},
journal = {Investigative Ophthalmology and Visual Science},
keywords = {Diabetic macular edema,Fundus fluorescein angiography,Leakage segmentation,Nonrigid registration},
number = {3},
pages = {1482--1492},
pmid = {25634978},
title = {{Fully automatic segmentation of fluorescein leakage in subjects with diabetic macular edema}},
volume = {56},
year = {2015}}


