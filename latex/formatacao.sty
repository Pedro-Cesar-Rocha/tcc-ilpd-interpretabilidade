\newcommand{\nota}[1]{%
\vspace{0.5cm}
\noindent
\begin{minipage}{\textwidth}
\begin{center}
\begin{tabular}{|p{0.8\textwidth}|}
\hline \\
\vspace{-0.7cm}\emph{\textbf{Nota:} #1}\\
\hline
\end{tabular}
\end{center}
\end{minipage}
\vspace{0.4cm}%
}%


\newcommand{\citacaodireta}[3]{%
\begin{footnotesize}
\hspace{4cm}
